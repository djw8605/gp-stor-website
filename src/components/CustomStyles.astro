---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  /*
   * Palette sampled from the Great Plains sunset hero photograph:
   * ember orange from the horizon glow, dusk indigo from the upper sky,
   * and warm golden light for the section bands.
   */
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(194 65 12);
    --aw-color-secondary: rgb(146 44 10);
    --aw-color-accent: rgb(72 61 139);

    --aw-color-text-heading: rgb(28 22 34);
    --aw-color-text-default: rgb(41 32 46);
    --aw-color-text-muted: rgb(41 32 46 / 70%);
    --aw-color-bg-page: rgb(255 253 250);
    --aw-color-bg-band: rgb(253 240 226);

    --aw-color-bg-page-dark: rgb(21 19 44);

    ::selection {
      background-color: rgb(253 224 190);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(203 74 18);
    --aw-color-secondary: rgb(160 50 12);
    --aw-color-accent: rgb(139 128 214);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(233 230 244);
    --aw-color-text-muted: rgb(233 230 244 / 70%);
    --aw-color-bg-page: rgb(21 19 44);
    --aw-color-bg-band: rgb(32 29 63);

    ::selection {
      background-color: rgb(146 44 10);
      color: snow;
    }
  }
</style>
