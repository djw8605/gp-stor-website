---
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { CallToAction } from '~/types';

export interface Stat {
  value: string;
  label: string;
  icon: string;
}

/** A marker drawn over the photograph, positioned in the SVG's own 900x460 space. */
export interface Hub {
  name: string;
  /** Marker position. */
  x: number;
  y: number;
  /** Baseline of the label that sits above the marker on a leader line. */
  labelY: number;
}

export interface Props {
  id?: string;
  image: ImageMetadata;
  /** Focal point of the photograph, in its own (unmirrored) coordinates. */
  imagePosition?: string;
  /** Flip the photograph horizontally, for images whose light falls on the copy side. */
  mirror?: boolean;
  actions?: Array<CallToAction>;
  stats?: Array<Stat>;
  hubs?: Array<Hub>;
}

const {
  id,
  image,
  imagePosition = '50% 45%',
  mirror = false,
  actions = [],
  stats = [],
  hubs = [],
} = Astro.props;

const title = await Astro.slots.render('title');
const subtitle = await Astro.slots.render('subtitle');

// Links between consecutive hubs arc upward; the long link between the first
// and last hub sweeps below them, so the three markers read as a ring.
const links: string[] = [];

for (let i = 0; i < hubs.length - 1; i++) {
  const from = hubs[i];
  const to = hubs[i + 1];
  links.push(`M ${from.x} ${from.y} Q ${(from.x + to.x) / 2} ${Math.min(from.y, to.y) - 48} ${to.x} ${to.y}`);
}

if (hubs.length > 2) {
  const from = hubs[0];
  const to = hubs[hubs.length - 1];
  links.push(`M ${from.x} ${from.y} Q ${(from.x + to.x) / 2} ${Math.max(from.y, to.y) + 88} ${to.x} ${to.y}`);
}

// Tails that run off the edge of the frame, so the network reads as part of
// something larger rather than as three isolated points.
const tails = hubs.length
  ? [
      `M ${hubs[0].x} ${hubs[0].y} Q ${hubs[0].x - 120} ${hubs[0].y + 70} 30 ${hubs[0].y + 128}`,
      `M ${hubs[hubs.length - 1].x} ${hubs[hubs.length - 1].y} Q ${hubs[hubs.length - 1].x + 95} ${
        hubs[hubs.length - 1].y + 22
      } 990 ${hubs[hubs.length - 1].y + 58}`,
    ]
  : [];
---

<section class="relative -mt-[4.5rem] overflow-hidden not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={image}
      alt=""
      class:list={['absolute inset-0 h-full w-full', { 'scale-x-[-1]': mirror }]}
      layout="cover"
      objectPosition={imagePosition}
      widths={[640, 1024, 1536]}
      sizes="100vw"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      width={1536}
      height={1024}
    />

    {/* Navy ground on the left, where the copy sits; the sunset stays legible on the right. */}
    <div class="absolute inset-0 bg-[#0a1628]/70 lg:hidden"></div>
    <div
      class="absolute inset-0 hidden lg:block bg-gradient-to-r from-[#0a1628] from-[4%] via-[#0a1628]/80 via-[40%] to-transparent to-[80%]"
    >
    </div>
    {/* Darker band behind the transparent header, and a settle to solid navy
        under the stats panel so the hero ends on a clean edge. */}
    <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-[#0a1628]/85 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-b from-transparent via-[#0a1628]/75 to-[#0a1628]">
    </div>
    {
      hubs.length > 0 && (
        <div class="pointer-events-none absolute right-[3%] top-[25%] hidden w-[47%] max-w-[54rem] lg:block xl:w-[52%]">
          <svg class="hero-map h-auto w-full" viewBox="0 0 900 460" fill="none" aria-hidden="true">
            <defs>
              <radialGradient id="hero-hub-glow">
                <stop offset="0%" stop-color="#FDE68A" stop-opacity="0.75" />
                <stop offset="30%" stop-color="#F59E0B" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#F59E0B" stop-opacity="0" />
              </radialGradient>
            </defs>

            <g class="hero-map__links">
              {[...links, ...tails].map((d) => (
                <>
                  <path d={d} stroke="#60A5FA" stroke-opacity="0.7" stroke-width="1.3" />
                  <path
                    d={d}
                    stroke="#DBEAFE"
                    stroke-opacity="1"
                    stroke-width="2.6"
                    stroke-linecap="round"
                    stroke-dasharray="0.1 26"
                  />
                </>
              ))}
            </g>

            {hubs.map((hub) => (
              <g>
                <line
                  x1={hub.x}
                  y1={hub.labelY + 30}
                  x2={hub.x}
                  y2={hub.y - 16}
                  stroke="#FCD34D"
                  stroke-opacity="0.55"
                  stroke-width="1"
                />
                <text class="hero-map__place" x={hub.x} y={hub.labelY}>
                  {hub.name.toUpperCase()}
                </text>
                <text class="hero-map__role" x={hub.x} y={hub.labelY + 21}>
                  DATA HUB
                </text>
                <circle cx={hub.x} cy={hub.y} r="62" fill="url(#hero-hub-glow)" />
                <circle class="hero-map__halo" cx={hub.x} cy={hub.y} r="19" fill="#FBBF24" fill-opacity="0.8" />
                <circle class="hero-map__node" cx={hub.x} cy={hub.y} r="7" fill="#FFFDF5" />
              </g>
            ))}
          </svg>
        </div>
      )
    }
  </div>

  <div class="relative mx-auto max-w-7xl px-4 pb-14 pt-[4.5rem] sm:px-6 md:pb-16">
    <div class="pt-12 md:pt-20 lg:pt-24">
      <div class="max-w-2xl">
        {title && <h1 class="hero-title" set:html={title} />}
        {subtitle && <p class="hero-subtitle" set:html={subtitle} />}

        {
          actions.length > 0 && (
            <div class="mt-9 flex flex-col gap-4 sm:flex-row">
              {actions.map((action) => (
                <div class="flex w-full sm:w-auto">
                  <Button {...action} class="w-full sm:w-auto" />
                </div>
              ))}
            </div>
          )
        }
      </div>

      {
        stats.length > 0 && (
          <div class="mt-14 rounded-xl border border-white/15 bg-white/[0.07] backdrop-blur-md md:mt-20">
            <div id="hero-stats" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
              {stats.map((stat) => (
                <div class="flex items-center gap-4 px-6 py-6">
                  <Icon name={stat.icon} class="h-9 w-9 shrink-0 text-blue-400" />
                  <div>
                    <div class="font-heading text-2xl font-bold leading-none text-white sm:text-3xl">{stat.value}</div>
                    <div class="mt-2 max-w-[9rem] text-sm leading-snug text-slate-300">{stat.label}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        Astro.slots.has('footnote') && (
          <div class="mx-auto mt-7 flex max-w-4xl items-start gap-3">
            <Icon name="tabler:users-group" class="mt-0.5 h-6 w-6 shrink-0 text-blue-400" />
            <p class="text-sm leading-relaxed text-slate-300 sm:text-base">
              <slot name="footnote" />
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
