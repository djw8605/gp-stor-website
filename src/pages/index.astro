---
import Layout from '~/layouts/PageLayout.astro';
import HeroHome from '~/components/widgets/HeroHome.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StatusSteps from '~/components/widgets/StatusSteps.astro';
import EventsLatestPosts from '~/components/widgets/EventsLatestPosts.astro';
import InstitutionGrid from '~/components/InstitutionGrid.astro';
import CentralStatesMap from '~/components/common/CentralStatesMap.astro';
import HeroBackground from '~/assets/images/hero-plains-sunset.jpg';
import PhotoBackdrop from '~/components/common/PhotoBackdrop.astro';
import DataPathsDiagram from '~/components/common/DataPathsDiagram.astro';
import pastureTrack from '~/assets/images/raychel-sanner-eJhUdqHChsY-unsplash.jpg';
import stormField from '~/assets/images/raychel-sanner-nqu5L_xc6bc-unsplash.jpg';

const metadata = {
  // The short name leads: reviewers keep this open in a tab beside a dozen others.
  title: 'GP-STOR | Great Plains Scalable Tiered Object Repository',
  ignoreTitleTemplate: true,
};

/* Same four partners as the People page, in the order the storage sites appear
   west to east, with the consortium last. */
const institutions = [
  {
    name: 'University of South Dakota',
    role: 'Storage site',
    logo: '/images/logos/usd.svg',
    logoClass: 'max-h-12 lg:max-h-10',
    href: 'https://www.usd.edu/',
  },
  {
    name: 'University of Nebraska–Lincoln',
    role: 'Storage site',
    logo: '/images/logos/unl.svg',
    logoClass: 'max-h-16 lg:max-h-14',
    href: 'https://www.unl.edu/',
  },
  {
    name: 'University of Missouri',
    role: 'Storage site',
    logo: '/images/logos/mizzou.svg',
    logoClass: 'max-h-11 lg:max-h-9',
    href: 'https://missouri.edu/',
  },
  {
    name: 'Great Plains Network',
    role: 'Regional consortium',
    logo: '/images/logos/gpn.png',
    logoClass: 'max-h-16 lg:max-h-14',
    href: 'https://www.greatplains.net/',
  },
];
---

<Layout metadata={metadata} id="front-page" bodyClass="header-over-photo">
  <!-- Hero Widget ******************* -->
  <HeroHome
    id="hero-sunset"
    image={HeroBackground}
    imagePosition="20% 52%"
    mirror
    actions={[
      { text: 'Read the Overview', href: '/docs/overview', variant: 'primary', icon: 'tabler:arrow-right' },
      { text: 'See the Roadmap', href: '#roadmap', variant: 'secondary', icon: 'tabler:arrow-down' },
    ]}
    stats={[
      { value: '14 PB', label: 'Distributed Object Storage', icon: 'tabler:database' },
      { value: '384 TB', label: 'High-Speed SSD Tier', icon: 'tabler:gauge' },
      { value: '3 Sites', label: 'Regional Resilience', icon: 'tabler:shield-check' },
      { value: '2027', label: 'Open Access Begins', icon: 'tabler:calendar-event' },
    ]}
    statsNote={{
      text: 'Capacity as designed. Hardware is in procurement now.',
      link: { text: 'See the roadmap', href: '#roadmap' },
    }}
    hubs={[
      { name: 'South Dakota', x: 150, y: 245, labelY: 40 },
      { name: 'Nebraska', x: 452, y: 302, labelY: 108 },
      { name: 'Missouri', x: 726, y: 372, labelY: 196 },
    ]}
  >
    <Fragment slot="title">
      Research Storage<br />at Great Plains Scale
    </Fragment>

    <Fragment slot="subtitle">
      Providing distributed, resilient storage infrastructure for data-intensive research, AI/ML workflows, scientific
      simulations, and collaborative discovery across the Great Plains region.
    </Fragment>

    <Fragment slot="footnote">
      GP-STOR connects researchers and institutions across <span class="font-medium text-blue-400">Missouri</span>,
      <span class="font-medium text-blue-400">Nebraska</span>, and
      <span class="font-medium text-blue-400">South Dakota</span> to accelerate discovery through reliable, scalable, and
      accessible data infrastructure.
    </Fragment>
  </HeroHome>

  <!-- Features Widget *************** -->
  <Features
    id="features"
    title="One storage service across three campuses"
    subtitle="A tier for the data you keep and a tier for the data you are working on right now, reachable from the compute you already use."
    items={[
      {
        title: 'Tiered, Distributed Storage',
        description: '14 PB of redundant Ceph object storage for data at rest, plus 384 TB of solid-state storage for AI/ML streaming, simulation output, and instrument data.',
        icon: 'tabler:server',
      },
      {
        title: 'Three-Site Resilience',
        description: 'Capacity is split across the University of Missouri, the University of Nebraska, and the University of South Dakota, so one site going offline does not take your data with it.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Access From Existing Workflows',
        description: 'Mounts for the OSG and the National Research Platform, Globus transfers, OSDF origins, and a web UI, so jobs and transfers run through the tools already in use.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Training and Support',
        description: 'Virtual office hours, video walkthroughs, and step-by-step guides, so a group new to this kind of storage is not left to work it out alone.',
        icon: 'tabler:school',
      },
    ]}
    >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-band"></div>
    </Fragment>
    </Features>

  <!-- Who is behind it *************** -->
  {/* Who holds the hardware and who funds it, stated once, in the open. A
      reviewer checking on the project should not have to reach the footer to
      find the award number, and a researcher deciding whether this is real
      should not have to reach the People page to find the institutions. */}
  <section class="px-4 py-16 sm:px-6 md:py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto mb-10 max-w-3xl text-center md:mb-12">
        <h2 class="mb-4 font-heading text-3xl font-bold leading-tight tracking-tight md:text-4xl">
          Built and operated by four partners
        </h2>
        <p class="text-lg text-muted dark:text-slate-400">
          Three campuses hold the distributed storage. The Great Plains Network connects them to the wider region.
        </p>
      </div>

      <InstitutionGrid institutions={institutions} />

      <p class="mt-8 text-center text-sm text-muted dark:text-slate-400">
        Supported by National Science Foundation award{' '}
        <a
          class="font-medium text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary dark:text-blue-400 dark:decoration-blue-400/40 dark:hover:decoration-blue-400"
          href="https://www.nsf.gov/awardsearch/show-award?AWD_ID=2502799"
          target="_blank"
          rel="noopener noreferrer">OAC-2502799</a
        >.
      </p>
    </div>
  </section>

  <!-- Events Widget ******************* -->
  <EventsLatestPosts
    title="Latest Events"
    information="Workshops, trainings, and community events across the region."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 dark:bg-transparent"></div>
    </Fragment>
  </EventsLatestPosts>

  <!-- Content Widget 1: What GP-STOR Provides *** -->
  <Content
    title="Getting Data In and Out"
    subtitle="Four ways onto the same storage, each matching how research data already moves"
    isReversed={false}
    callToAction={{ text: 'How each access method works', href: '/docs/access', icon: 'tabler:arrow-right' }}
    items={[
      {
        title: 'OSG and NRP Mounts',
        description:
          'Mount GP-STOR directly in high-throughput computing jobs on the Open Science Grid and the National Research Platform.',
      },
      {
        title: 'OSDF Origin Nodes',
        description:
          'Publish datasets to the Open Science Data Federation and have them served out to jobs wherever those jobs land.',
      },
      {
        title: 'Globus Transfers',
        description:
          'Managed, high-performance transfers for moving large collections between GP-STOR, campus storage, and collaborators elsewhere.',
      },
      {
        title: 'Nextcloud Web UI',
        description:
          'Browse, upload, and share through a web interface, for the work that does not belong on a command line.',
      },
    ]}
  >
    <Fragment slot="image">
      <DataPathsDiagram />
    </Fragment>

    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Reachable From <br /><span class="text-2xl">the Tools You Already Run</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-band"></div>
    </Fragment>
  </Content>

  <!-- Content Widget 3: Research Use Cases *** -->
  <Content
    title="Research Use Cases"
    subtitle="The workloads the tiered design was built around"
    isReversed={false}
    callToAction={{ text: 'Who can use GP-STOR, and what it costs', href: '/docs/faq', icon: 'tabler:arrow-right' }}
    items={[
      {
        title: 'AI and Machine Learning',
        description:
          'The solid-state tier is built for streaming data straight into AI/ML algorithms, rather than staging it somewhere else first.',
      },
      {
        title: 'Scientific Simulations',
        description:
          'Land simulation output on the object tier as it is produced, then distribute the curated results with Globus.',
      },
      {
        title: 'Instrument Data Pipelines',
        description:
          'Stream instrument data to the high-speed tier for preprocessing and analysis, then keep it alongside everything else.',
      },
      {
        title: 'Classroom and Coursework',
        description:
          'Give students hands-on time with the same cyberinfrastructure their field runs on, in coursework and in research projects.',
      },
    ]}
    image={{
      src: stormField,
      alt: 'A storm front moving over a wheat field on the Great Plains',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        From Instrument and Simulation <br /><span class="text-2xl">Through to Analysis</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 "></div>
    </Fragment>
  </Content>

  <!-- Content Widget 4: Regional Impact *** -->
  <Content
    title="Regional Impact"
    subtitle="Cyberinfrastructure for a region where it has been hard to build"
    isReversed={true}
    callToAction={{ text: 'The team and partner institutions', href: '/people', icon: 'tabler:arrow-right' }}
    items={[
      {
        title: 'Rural Cyberinfrastructure',
        description:
          'Deploying advanced infrastructure in rural regions, where awareness and literacy of high-throughput computing are still emerging.',
      },
      {
        title: 'Workforce Development',
        description:
          'Building an engineering and facilitation workforce able to design and run an interstate research platform.',
      },
      {
        title: 'Under-Resourced Institutions',
        description:
          'Focused on the campuses that have had the least access to infrastructure like this, including PUIs and tribal colleges.',
      },
      {
        title: 'Regional Economy',
        description:
          'Supporting the industrial sectors the region depends on, including agriculture and advanced materials.',
      },
    ]}
  >
    <Fragment slot="image">
      <CentralStatesMap />
    </Fragment>

    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Built for the Region, <br /><span class="text-2xl">Reproducible Nationwide</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-band"></div>
    </Fragment>
  </Content>

  <!-- Timeline / Steps Widget ******* -->
  <StatusSteps
    id="roadmap"
    title="GP-STOR Roadmap"
    subtitle="Where the project stands today, and what comes between here and open access."
    items={[
      {
        title: 'Q3 2026: Infrastructure acquisition',
        description: 'Finalize specifications and procure infrastructure for GP‑STOR.',
        icon: 'tabler:shopping-cart',
        status: 'active',
      },
      {
        title: 'Q4 2026: Receive hardware',
        description: 'Delivery and rack/cabinet intake at sites; begin inventory and staging.',
        icon: 'tabler:truck-delivery',
        status: 'todo',
      },
      {
        title: 'Q4 2026-Q1 2027: Deploy and configure',
        description: 'Install CEPH clusters across sites, configure replication, pools, and monitoring.',
        icon: 'tabler:settings',
        status: 'todo',
      },
      {
        title: 'Q1 2027: Deploy storage interfaces',
        description: 'Enable access methods such as a web interface and mounting on National Research Platform.',
        icon: 'tabler:plug-connected',
        status: 'todo',
      },
      {
        title: 'Q2 2027: Beta users',
        description: 'Onboard early adopters for real-world testing and performance tuning.',
        icon: 'tabler:users',
        status: 'todo',
      },
      {
        title: 'Q3 2027: Open access & trainings',
        description: 'Public access opens, training sessions held, and operational support transitions to steady‑state.',
        icon: 'tabler:door-enter',
        status: 'todo',
      },
      {
        title: 'Q4 2027: Convene user group',
        description: 'Bring together early stakeholders and beta participants to solicit feedback on service design and policies.',
        icon: 'tabler:users-group',
        status: 'todo',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    isDark
    classes={{
      container:
        'my-12 max-w-5xl rounded-2xl bg-[#0a1628]/70 px-6 py-12 backdrop-blur-[2px] md:my-16 md:px-10 md:py-16',
      // The container above is already the plate; the widget's own boxed panel
      // would put a second frame around the same words.
      panel: 'p-0 rounded-none shadow-none dark:border-0 dark:shadow-none',
    }}
    actions={[
      {
        variant: 'primary',
        text: 'Find Your Campus Lead',
        href: '/people',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'secondary',
        text: 'How to Get in Touch',
        href: '/docs/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="bg">
      <PhotoBackdrop image={pastureTrack} position="50% 58%" scrim={60} />
    </Fragment>

    <Fragment slot="title">
      Planning work that will need this?
    </Fragment>

    <Fragment slot="subtitle">
      GP-STOR is in the acquisition and deployment phase, with open access scheduled for 2027. Talk to your campus CI
      lead now so your storage needs are known before beta onboarding begins.
    </Fragment>
  </CallToAction>
</Layout>
