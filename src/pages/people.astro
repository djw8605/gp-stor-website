---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import PeopleGrid from '~/components/PeopleGrid.astro';
import InstitutionGrid from '~/components/InstitutionGrid.astro';
import Features2 from '~/components/widgets/Features2.astro';
import PhotoBackdrop from '~/components/common/PhotoBackdrop.astro';
import stormOverWheat from '~/assets/images/raychel-sanner-nqu5L_xc6bc-unsplash.jpg';

const metadata = {
  title: 'Team & Partners',
  description: 'Meet the GP-STOR team and collaborating institutions',
};

/* Each logo is the institution's own reversed variant; see
   docs/institution-logos.md. `logoClass` is optical, not literal -- the
   square Nebraska "N" needs more height than the wide signatures to carry the
   same visual weight beside them. */
const institutions = [
  {
    name: 'University of Nebraska–Lincoln',
    role: 'Storage site',
    logo: '/images/logos/unl.svg',
    logoClass: 'max-h-16 lg:max-h-14',
    href: 'https://www.unl.edu/',
  },
  {
    name: 'University of South Dakota',
    role: 'Storage site',
    logo: '/images/logos/usd.svg',
    logoClass: 'max-h-12 lg:max-h-10',
    href: 'https://www.usd.edu/',
  },
  {
    name: 'University of Missouri',
    role: 'Storage site',
    logo: '/images/logos/mizzou.svg',
    logoClass: 'max-h-11 lg:max-h-9',
    href: 'https://missouri.edu/',
  },
  {
    name: 'Great Plains Network',
    role: 'Regional consortium',
    logo: '/images/logos/gpn.png',
    logoClass: 'max-h-16 lg:max-h-14',
    href: 'https://www.greatplains.net/',
  },
];

const people = [
  {
    name: 'Derek Weitzel',
    title: 'Research Associate Professor',
    institution: 'University of Nebraska-Lincoln',
    image: '/images/derek-weitzel.jpg',
    social: [
      { label: 'GitHub', href: 'https://github.com/djw8605', icon: 'github' },
      { label: 'Website', href: 'https://derekweitzel.com', icon: 'information' },
    ],
  },
  {
    name: 'Ryan Johnson',
    title: 'Director of Research Computing',
    image: '/images/ryan-johnson.jpg',
    institution: 'University of South Dakota',
    social: [
      { href: 'https://rcg.usd.edu/', label: 'Website', icon: 'information' },
    ]
  },
  {
    name: 'Matthew Keeler',
    title: 'Director - Research Support Solutions',
    institution: 'University of Missouri-Columbia',
    image: '/images/matthew-keeler.jpg',
    social: [
      { href: 'https://doit.missouri.edu/services/it-research-support-solutions/', label: 'Website', icon: 'information' },
    ]
  },
];
---

<Layout metadata={metadata} bodyClass="header-over-photo">
  <!-- Hero Widget ******************* -->
  <Hero whiteText>
    <Fragment slot="bg">
      <PhotoBackdrop image={stormOverWheat} position="50% 62%" scrim={68} headerFade eager />
    </Fragment>

    <Fragment slot="title">
      Team & Partners
    </Fragment>

    <Fragment slot="subtitle">
      The GP-STOR project is led by a collaborative team of cyberinfrastructure experts from institutions across the Great Plains region.
    </Fragment>
  </Hero>

  <!-- Principal Investigators Section -->
  <section class="px-4 py-4 mx-auto max-w-7xl sm:px-6 lg:px-8 lg:py-4">
    <div class="mb-10 md:mx-auto text-center md:mb-12 max-w-3xl">
      <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Principal Investigators
      </h2>
    </div>
    
    <PeopleGrid people={people} />
  </section>

  <!-- Collaborating Institutions -->
  <section class="px-4 py-20 mx-auto sm:px-6 lg:px-8 lg:py-20 bg-band">
    <div class="max-w-7xl mx-auto">
      <div class="mb-10 md:mx-auto text-center md:mb-12 max-w-3xl">
        <h2 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
          Collaborating Institutions
        </h2>
        <p class="text-xl text-muted dark:text-slate-400">
          Three campuses hold the distributed storage, and the Great Plains Network connects them to the wider region.
        </p>
      </div>

      <InstitutionGrid institutions={institutions} class="max-w-6xl mx-auto" />
    </div>
  </section>

  <!-- Related Projects -->
  <Features2
    title="Related Projects"
    subtitle="GP-STOR extends and enhances prior NSF investments"
    items={[
      {
        title: 'GPN CyberTeams',
        description: 'NSF #1925681',
        icon: 'tabler:users',
      },
      {
        title: 'GP-ARGO',
        description: 'Great Plains Augmented Regional Gateway to the Open Science Grid - NSF #2018766',
        icon: 'tabler:network',
        callToAction: {
          text: 'Visit GP-ARGO',
          href: 'https://gp-argo.greatplains.net',
        },
      },
      {
        title: 'GP-ENGINE',
        description: 'Great Plains Extended Network of GPUs for Interactive Experimenters - NSF #2322218',
        icon: 'tabler:cpu',
        callToAction: {
          text: 'Visit GP-ENGINE',
          href: 'https://gp-engine.org',
        },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 dark:bg-transparent"></div>
    </Fragment>
  </Features2>
</Layout>
